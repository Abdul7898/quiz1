@model IEnumerable<quiz1.Models.Entity.QuizQuestion>

@{
    ViewData["Title"] = "Quiz Questions";
}

<h2>Quiz Questions</h2>

<a asp-controller="Quiz" asp-action="Create" class="btn btn-primary mb-3">
    Add New Question
</a>


<table class="table table-bordered">
    <thead>
        <tr>
            <th>Question</th>
            <th>Option A</th>
            <th>Option B</th>
            <th>Option C</th>
            <th>Option D</th>
            <th>Correct Option</th>
            <th style="width: 160px;">Actions</th>
        </tr>
    </thead>

    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.QuestionText</td>
                    <td>@item.OptionA</td>
                    <td>@item.OptionB</td>
                    <td>@item.OptionC</td>
                    <td>@item.OptionD</td>
                    <td>@item.CorrectOption</td>
                    <td>
                        <a asp-controller="Quiz"
                           asp-action="Delete"
                           asp-route-id="@item.Id"
                           class="btn btn-danger btn-sm">
                            Delete
                        </a>

                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="7" class="text-center">No questions found.</td>
            </tr>
        }
    </tbody>
</table>
