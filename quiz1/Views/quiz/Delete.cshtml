@model quiz1.Models.Entity.QuizQuestion

@{
    ViewData["Title"] = "Delete Question";
}

<h2>Delete Question</h2>

<p>Are you sure you want to delete this question?</p>

<div class="mb-3">
    <strong>Question:</strong> @Model.QuestionText
</div>

<form asp-controller="Quiz" asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">
        Delete
    </button>

    <a asp-controller="Quiz" asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>
</form>
